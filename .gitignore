.env.bak
.env.*.bak
.direnv

# Local-only docker compose override (per-developer mongo port/container)
compose.override.yaml

# Per-developer env-var wrapper for the SST personal-stage path (Tier 2).
# Copy for-env.example -> for-env and fill in real (private) stage values.
/for-env

*.tsbuildinfo

.cursor/rules
.cursor/tasks.json

.aider*

# Premium infra codegen (Open Core). Generated by scripts/generate-premium-glue.mjs.
infra/premium-generated/

# Premium migrations codegen (Open Core). Generated by scripts/generate-premium-glue.mjs.
packages/scripts/migrate/migrations/premium.generated.ts

# Premium overlay snapshot for b4m-overwatch — hydrated at pinned ref by deploy job.
# The committed snapshot is removed so lumina5 can be open-sourced; the deploy job
# clones the pinned ref supplied by the deploy pipeline before pnpm install.
packages/premium/overwatch/

# Premium overlay snapshot for b4m-libreoncology — hydrated at pinned ref by deploy job.
# The committed snapshot is removed so lumina5 can be open-sourced; the deploy job
# clones the pinned ref supplied by the deploy pipeline before pnpm install.
packages/premium/libreoncology/

# Premium overlay snapshot for b4m-pi — hydrated at pinned ref by deploy job.
# The committed snapshot is removed so lumina5 can be open-sourced; the deploy job
# clones the pinned ref supplied by the deploy pipeline before pnpm install.
packages/premium/pi/

# Premium overlay snapshot for b4m-tavern — hydrated at pinned ref by deploy job.
# The committed snapshot is removed so lumina5 can be open-sourced; the deploy job
# clones the pinned ref supplied by the deploy pipeline before pnpm install.
packages/premium/tavern/

# Premium overlay snapshot for b4m-optihashi, hydrated at the pinned ref by the
# deploy pipeline before pnpm install. Missing entry meant a local overlay clone
# showed as untracked and one bulk `git add` away from publishing private
# overlay code.
packages/premium/optihashi/

# Premium overlay snapshot for b4m-bob, hydrated at the pinned ref by the deploy
# pipeline before pnpm install. bootstrap-premium.sh clones every overlay in the
# deployer's overlay-pins.json, so without this entry a local `pnpm bootstrap:premium`
# against this PUBLIC checkout leaves private overlay source untracked, one bulk
# `git add` away from publishing it. Same near-miss the optihashi entry above records.
packages/premium/bob/

# Premium overlay snapshot for b4m-interactive-meetings, hydrated at the pinned ref by the
# deploy pipeline before pnpm install. Seventh of the enumerated overlays: there is no
# blanket packages/premium/*/ pattern here on purpose, so an unlisted overlay mount shows
# as untracked and is one bulk `git add` away from publishing private source into this
# PUBLIC repo. Same near-miss the optihashi and bob entries above record.
packages/premium/interactive-meetings/

# Premium overlay snapshot for b4m-arnold — hydrated at the pinned ref by the deploy
# pipeline before pnpm install. Without this entry a local clone leaves private overlay
# source untracked, one bulk `git add` away from publishing it.
packages/premium/arnold/

