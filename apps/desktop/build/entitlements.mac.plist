<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime blocks these by default, and this app needs all three: every
       renderer runs V8's JIT, and the chat tools spawn shell commands, dev servers and
       stdio MCP servers, none of which carry this app's signature. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The OAuth device flow and every API call the main process makes. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
