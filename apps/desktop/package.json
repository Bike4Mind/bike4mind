{
  "name": "@bike4mind/desktop",
  "version": "0.2.9",
  "private": true,
  "description": "Bike4Mind Electron desktop client",
  "author": "Bike4Mind",
  "license": "BUSL-1.1",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:host": "vite build --config vite.host.config.ts",
    "package": "electron-vite build && node scripts/package-local.cjs",
    "package:mac": "electron-vite build && node scripts/package-local.cjs --mac",
    "package:win": "electron-vite build && node scripts/package-local.cjs --win",
    "package:linux": "electron-vite build && node scripts/package-local.cjs --linux",
    "package:dir": "electron-vite build && node scripts/package-local.cjs --dir",
    "preview": "electron-vite preview",
    "ladle": "ladle serve",
    "start": "electron .",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
    "test": "node --test scripts/test_package_local.cjs scripts/test_dev_version.cjs scripts/test_controlled_cost_evaluation.cjs scripts/test_host_artifact.cjs && vitest run",
    "test:repo": "REPO_TEST_LANE=repo vitest run",
    "test:watch": "vitest",
    "check:curated": "vitest run --config vitest.curated.config.ts",
    "lint": "eslint .",
    "clean": "rm -rf node_modules out"
  },
  "dependencies": {
    "@bike4mind/client-auth": "workspace:*",
    "@bike4mind/common": "workspace:*",
    "@bike4mind/mcp": "workspace:*",
    "@bike4mind/services": "workspace:@bike4mind/services-core@*",
    "axios": "1.20.0",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^3.1.0",
    "node-pty": "1.2.0-beta.15",
    "unpdf": "^1.6.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@bike4mind/agents": "workspace:*",
    "@bike4mind/cli": "workspace:*",
    "@bike4mind/design-tokens": "workspace:*",
    "@bike4mind/local-models": "workspace:*",
    "@bike4mind/tsgo": "workspace:*",
    "@bike4mind/typescript-config": "workspace:*",
    "@bike4mind/utils": "workspace:*",
    "@ladle/react": "5.1.1",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/system": "^5.15.15",
    "@tanstack/react-router": "^1.170.44",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "manifold-3d": "3.5.4",
    "mermaid": "^11.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "0.187.0",
    "tree-sitter-bash": "0.25.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "web-tree-sitter": "0.25.10",
    "zustand": "^5.0.15"
  }
}
