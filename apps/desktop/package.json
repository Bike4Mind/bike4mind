{
  "name": "@bike4mind/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bike4Mind Electron desktop client",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:native": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
    "typecheck:fast": "pnpm typecheck:native || pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf node_modules out"
  },
  "dependencies": {
    "@bike4mind/client-auth": "workspace:*",
    "@bike4mind/common": "workspace:*",
    "@bike4mind/mcp": "workspace:*",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/system": "^5.15.15",
    "@tanstack/react-router": "^1.170.17",
    "axios": "1.18.0",
    "eventsource-parser": "^3.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bike4mind/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
