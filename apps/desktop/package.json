{
  "name": "@bike4mind/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bike4Mind Electron desktop client",
  "author": "Bike4Mind",
  "license": "BUSL-1.1",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:native": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
    "typecheck:fast": "pnpm typecheck:native || pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf node_modules out"
  },
  "dependencies": {
    "@bike4mind/client-auth": "workspace:*",
    "@bike4mind/common": "workspace:*",
    "@bike4mind/mcp": "workspace:*",
    "axios": "1.18.0",
    "electron-updater": "^6.8.9",
    "eventsource-parser": "^3.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bike4mind/agents": "workspace:*",
    "@bike4mind/cli": "workspace:*",
    "@bike4mind/typescript-config": "workspace:*",
    "@bike4mind/utils": "workspace:*",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/system": "^5.15.15",
    "@tanstack/react-router": "^1.170.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tree-sitter-bash": "0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "web-tree-sitter": "0.25.10"
  }
}
