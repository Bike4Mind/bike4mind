{
  "extends": "@bike4mind/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "moduleResolution": "bundler",
    "types": [
      "node",
      "electron-vite/node"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@bike4mind/cli/skills": [
        "../../packages/cli/src/skills/index.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/host/**/*.ts",
    "electron.vite.config.ts",
    "vite.host.config.ts",
    "buildShared.ts",
    "vitest.config.ts"
  ]
}
