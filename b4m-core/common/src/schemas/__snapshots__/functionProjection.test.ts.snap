exports[`projectFunctionSchema > renders the llm surface 1`] = `
{
  "description": "Checks a simply supported beam under a uniform load
Outputs: deflection (m), within_limit, reactions (N).",
  "name": "beam_check",
  "parameters": {
    "additionalProperties": false,
    "description": "Beam and load",
    "properties": {
      "label": {
        "description": "Length: at most 80.",
        "type": "string",
      },
      "load": {
        "description": "Unit: N/m. Range: 0 <= value < 1000000.",
        "type": "number",
      },
      "material": {
        "description": "Beam material. Length: at most 20. Default: "steel".",
        "enum": [
          "steel",
          "timber",
        ],
        "type": "string",
      },
      "notes": {
        "description": "Items: at most 3.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "segments": {
        "description": "Unit: 1. Default: 2.",
        "enum": [
          1,
          2,
          4,
        ],
        "type": "integer",
      },
      "span": {
        "description": "Beam span. Unit: m. Range: 0 < value <= 10. Default: 1.",
        "type": "number",
      },
      "supports": {
        "description": "Items: 2 to 5.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "fixed": {
              "description": "Whether the support resists rotation",
              "type": "boolean",
            },
            "position": {
              "description": "Unit: m. Range: value >= 0.",
              "type": "number",
            },
          },
          "required": [
            "position",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "temperature": {
        "description": "Unit: K. Range: value > 0.",
        "type": "number",
      },
      "verbose": {
        "description": "Default: false.",
        "type": "boolean",
      },
    },
    "required": [
      "span",
      "load",
      "supports",
    ],
    "type": "object",
  },
}
`;

