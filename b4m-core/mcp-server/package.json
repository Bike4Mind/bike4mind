{
  "name": "@bike4mind/mcp-server",
  "version": "0.1.0",
  "description": "Transport-agnostic Bike4Mind MCP tool framework shared by the stdio and hosted servers",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsdown",
    "incremental": "tsdown",
    "dev": "tsdown --watch",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck": "tsgo --noEmit --types node",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@bike4mind/common": "workspace:*",
    "@bike4mind/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.6"
  }
}
