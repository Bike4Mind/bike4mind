{
  "name": "@bike4mind/slack",
  "version": "8.0.6",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bike4Mind/bike4mind.git",
    "directory": "b4m-core/slack"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsdown",
    "incremental": "tsdown",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck":"tsgo --noEmit --types node",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@bike4mind/agents": "workspace:*",
    "@bike4mind/common": "workspace:*",
    "@bike4mind/fab-pipeline": "workspace:*",
    "@bike4mind/llm-adapters": "workspace:*",
    "@bike4mind/mcp": "workspace:*",
    "@bike4mind/observability": "workspace:*",
    "@bike4mind/services-core": "workspace:*",
    "@bike4mind/utils": "workspace:*",
    "@slack/oauth": "^3.0.5",
    "@slack/web-api": "^7.19.0",
    "cheerio": "1.2.0",
    "chrono-node": "^2.10.1",
    "dayjs": "^1.11.23",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "mongoose": "^8.24.7",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "mongoose": "^8.22.1"
  }
}
