{
  "scenario": "image-to-video.synthetic",
  "synthetic": true,
  "basis": "Hand-built: the submit body follows the documented image-to-video instance (image.inlineData.mimeType/data, unpaid and unverified live); responses mirror text-to-video.synthetic. Replace with a recording.",
  "exchanges": [
    {
      "name": "submit",
      "request": {
        "method": "POST",
        "path": "/v1beta/models/veo-3.1-fast-generate-preview:predictLongRunning",
        "body": {
          "instances": [
            {
              "prompt": "The color slowly ripples like water, camera static.",
              "image": {
                "inlineData": {
                  "mimeType": "image/png",
                  "data": "<redacted:base64 1132 chars>"
                }
              }
            }
          ],
          "parameters": {
            "durationSeconds": 4,
            "aspectRatio": "16:9",
            "resolution": "720p"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=UTF-8"
        },
        "body": {
          "name": "models/veo-3.1-fast-generate-preview/operations/synthetici2v"
        }
      }
    },
    {
      "name": "poll_first",
      "request": {
        "method": "GET",
        "path": "/v1beta/models/veo-3.1-fast-generate-preview/operations/synthetici2v"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=UTF-8"
        },
        "body": {
          "name": "models/veo-3.1-fast-generate-preview/operations/synthetici2v"
        }
      }
    },
    {
      "name": "poll_terminal",
