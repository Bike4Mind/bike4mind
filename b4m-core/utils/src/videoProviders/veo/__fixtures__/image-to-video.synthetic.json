        },
        "body": {
          "name": "models/veo-3.1-fast-generate-preview/operations/synthetici2v",
          "done": true,
          "response": {
            "@type": "type.googleapis.com/google.ai.generativelanguage.v1beta.PredictLongRunningResponse",
