{
  "scenario": "failed.synthetic",
  "synthetic": true,
  "basis": "Hand-built from the docs digest: status failed with error {code, message}, code from the documented enum. Replace with a recording.",
  "exchanges": [
    {
      "name": "submit",
      "request": {
        "method": "POST",
        "path": "/v1/videos/generations",
        "body": {
          "model": "grok-imagine-video-1.5",
          "prompt": "A paper boat drifting down a rainy street gutter.",
          "duration": 2,
          "aspect_ratio": "16:9",
          "resolution": "480p"
        }
      },
      "response": {
        "status": 200,
        "headers": { "content-type": "application/json" },
        "body": { "request_id": "synthetic-failed" }
      }
    },
    {
      "name": "poll_first",
      "request": { "method": "GET", "path": "/v1/videos/synthetic-failed" },
      "response": {
        "status": 200,
        "headers": { "content-type": "application/json" },
        "body": { "status": "pending", "progress": 5 }
      }
    },
    {
      "name": "poll_terminal",
      "request": { "method": "GET", "path": "/v1/videos/synthetic-failed" },
      "response": {
        "status": 200,
        "headers": { "content-type": "application/json" },
        "body": {
          "status": "failed",
          "error": { "code": "internal_error", "message": "The video could not be generated" }
        }
      }
    }
  ]
}
