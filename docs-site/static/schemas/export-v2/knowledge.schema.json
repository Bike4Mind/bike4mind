{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.bike4mind.com/schemas/export-v2/knowledge.schema.json",
  "title": "Knowledge file v2 record",
  "type": "object",
  "required": ["notebookId", "id", "name", "mimeType", "size", "uploadedAt"],
  "properties": {
    "notebookId": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "mimeType": { "type": "string" },
    "size": { "type": "integer", "minimum": 0 },
    "uploadedAt": { "type": "string", "format": "date-time" },
    "contentPath": { "type": "string", "pattern": "^files/[^/]+$" },
    "contentUrl": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
