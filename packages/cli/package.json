{
  "name": "@bike4mind/cli",
  "version": "5.0.2",
  "mcpName": "io.github.Bike4Mind/bike4mind",
  "type": "module",
  "description": "Interactive CLI tool for Bike4Mind with ReAct agents",
  "license": "BUSL-1.1",
  "author": "Bike4Mind",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bike4Mind/bike4mind.git"
  },
  "homepage": "https://github.com/bike4mind/bike4mind#readme",
  "bugs": "https://github.com/bike4mind/bike4mind/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "bike4mind",
    "agent",
    "mcp",
    "react-agent"
  ],
  "bin": {
    "b4m": "./bin/bike4mind-cli.mjs",
    "bike4mind": "./bin/bike4mind-cli.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "B4M_SOURCE_MODE=1 tsx src/index.tsx",
    "build": "tsdown",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck": "tsgo --noEmit --types node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts",
    "start": "node dist/index.mjs",
    "eval:run": "tsx src/evals/cli.ts",
    "postinstall": "node -e \"try { require('better-sqlite3') } catch (e) { if (e.message.includes('bindings')) { console.log('\\n\\u26a0\\ufe0f  Rebuilding better-sqlite3 native bindings...'); try { require('child_process').execSync('pnpm rebuild better-sqlite3', {stdio:'inherit'}) } catch { console.log('\\u26a0\\ufe0f  Could not rebuild better-sqlite3 automatically. If the CLI reports a native-bindings error, run: npm rebuild better-sqlite3') } } }\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@aws-sdk/client-sts": "^3.1150.0",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@mendable/firecrawl-js": "^1.29.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "axios": "1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "1.2.0",
    "cli-highlight": "^2.1.11",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "eventsource-parser": "^3.1.0",
    "fuse.js": "^7.5.0",
    "fzf": "^0.5.2",
    "glob": "^14.0.2",
    "ignore": "^7.0.9",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lodash": "^4.18.1",
    "marked": "^15.0.11",
    "mathjs": "^15.2.0",
    "mongoose": "^8.24.7",
    "ollama": "^0.6.3",
    "open": "^11.0.4",
    "openai": "^6.46.0",
    "react": "^19.3.0",
    "sharp": "^0.35.4",
    "shell-quote": "^1.12.0",
    "tiktoken": "^1.0.22",
    "tldts": "^7.4.13",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.4",
    "undici": "^7.29.0",
    "web-tree-sitter": "0.25.10",
    "wrap-ansi": "^9.0.2",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "yargs": "^18.1.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@bike4mind/agents": "workspace:*",
    "@bike4mind/client-auth": "workspace:*",
    "@bike4mind/common": "workspace:*",
    "@bike4mind/fab-pipeline": "workspace:*",
    "@bike4mind/hearth": "workspace:*",
    "@bike4mind/llm-adapters": "workspace:*",
    "@bike4mind/local-models": "workspace:*",
    "@bike4mind/mcp": "workspace:*",
    "@bike4mind/model-host": "workspace:*",
    "@bike4mind/observability": "workspace:*",
    "@bike4mind/sdk": "workspace:*",
    "@bike4mind/services": "workspace:@bike4mind/services-core@*",
    "@bike4mind/utils": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}
