{
  "name": "@bike4mind/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical design tokens for all first-party clients, with per-target emitters.",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsdown",
    "incremental": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "tsgo --noEmit --types node",
    "typecheck:fast": "tsgo --noEmit --types node || tsc --noEmit",
    "test": "vitest run",
    "generate:native": "tsx scripts/generateNative.ts"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
