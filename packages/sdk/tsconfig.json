{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    // No DOM: fetch, Response and ReadableStream come from @types/node, the same globals the
    // DOM-free consumer in scripts/check-published-dts.mjs has.
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules"]
}
