# Copy outside the checkout, chmod 600, and replace placeholders before creating a Secret.
# Each signing/encryption secret: openssl rand -hex 32
JWT_SECRET=replace-with-generated-secret
SESSION_SECRET=replace-with-generated-secret
SECRET_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
INTERNAL_WS_SECRET=replace-with-generated-secret
INTERNAL_S3_WEBHOOK_SECRET=replace-with-generated-secret
CHAT_COMPLETION_INTERNAL_SECRET=replace-with-generated-secret
MINIO_ROOT_USER=replace-with-private-user
MINIO_ROOT_PASSWORD=replace-with-generated-secret
# For the bundled MinIO, these must equal the two MINIO_ROOT_* values above.
# These are S3-compatible credentials; an AWS account is not required.
AWS_ACCESS_KEY_ID=replace-with-private-user
AWS_SECRET_ACCESS_KEY=replace-with-generated-secret
# Required only when agentExecutor.enabled=true.
# AGENT_EXECUTOR_INTERNAL_SECRET=replace-with-generated-secret
# Optional provider credentials or endpoint overrides can also be placed here.
# OPENAI_API_KEY=
# BEDROCK_REGION=us-east-1
