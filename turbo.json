{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  // dataLakeSearchMetrics.test.ts reads infra/dataLakeSearchDashboard.ts to pin the metric names
  // the dashboard graphs, because infra/ cannot import the constants. That file sits outside every
  // package, so without it here a dashboard-only edit is a cache hit for the very test meant to
  // catch it. Global rather than a task input: package-relative escapes resolve differently for
  // the depth-3 overlay packages, and this file changes rarely enough that the blunt key is cheap.
  //
  // vitest.shared.ts is the shared base nearly every package's vitest config imports from the root.
  "globalDependencies": ["infra/dataLakeSearchDashboard.ts", "vitest.shared.ts"],
  "tasks": {
    "codegen": {
      // Not cacheable: output depends on node_modules link state (which overlay
      // packages resolve), which no input glob can capture. A cache replay would
      // restore glue for the WRONG link state. The script is sub-second.
      "cache": false,
      "inputs": ["scripts/generate-premium-glue.mjs", "../../packages/premium/*/package.json", "../../sst.config.ts"],
      "outputs": [
        "app/premium-generated/**",
        "pages/api/premium-*/**",
        "server/premium-generated/**",
        "../../infra/premium-generated/**",
        "../../packages/server-utils/src/premium-generated/**",
        "../../packages/scripts/migrate/migrations/premium.generated.ts"
      ]
    },
    "build": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsdown.config.ts", "package.json"]
    },
    "typecheck": {
      "dependsOn": ["codegen", "^build"]
    },
    "//#typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:native": {
      "dependsOn": ["codegen", "^build"]
    },
    "//#typecheck:native": {
      "dependsOn": ["^build"]
    },
    "typecheck:fast": {
      "dependsOn": ["codegen", "^build"]
    },
    "//#typecheck:fast": {
      "dependsOn": ["^build"]
    },
    // @bike4mind/scripts consumes packages/scripts/migrate/migrations/premium.generated.ts
    // (written by @bike4mind/client's codegen task, see the "codegen" task above) even though
    // it has no ordinary dependency on @bike4mind/client - the generic "typecheck" task above
    // only depends on EACH package's own (same-package) "codegen" task, which is a no-op for
    // @bike4mind/scripts. These package-specific overrides add the missing cross-package edge;
    // package-specific config REPLACES the generic entry, so ^build is repeated here.
    "@bike4mind/scripts#typecheck": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../server-utils/**",
        "!../server-utils/node_modules/**",
        "!../server-utils/.turbo/**"
      ]
    },
    "@bike4mind/scripts#typecheck:native": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../server-utils/**",
        "!../server-utils/node_modules/**",
        "!../server-utils/.turbo/**"
      ]
    },
    "@bike4mind/scripts#typecheck:fast": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../server-utils/**",
        "!../server-utils/node_modules/**",
        "!../server-utils/.turbo/**"
      ]
    },
    // migrations/index.test.ts statically imports the same premium.generated.ts stub - same
    // cross-package edge as the typecheck overrides above, for the same reason.
    // Several tests read workspace manifests under b4m-core/ and packages/ and the curated lists, which sit outside the
    // package: without them as inputs, an edit to one replays a cached pass.
    "@bike4mind/scripts#test": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "../server-utils/**",
        "!../server-utils/node_modules/**",
        "!../server-utils/.turbo/**",
        "$TURBO_ROOT$/b4m-core/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/catalog/model-hub/**"
      ]
    },
    // The curated v3 schema and v2 converter tests read the lists in catalog/model-hub; the chunking
    // constants test lists the migrations directory.
    "@bike4mind/common#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "$TURBO_ROOT$/catalog/model-hub/**",
        "$TURBO_ROOT$/packages/scripts/migrate/migrations/**"
      ]
    },
    // mcpRegistryEntry.test.ts checks the published registry entry at the repo root.
    "@bike4mind/cli#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".turbo/test-context", "$TURBO_ROOT$/mcp-registry/**"]
    },
    // The hook tests run the CLI's bin/hearth-hook.mjs, which is outside cli's build inputs.
    "@bike4mind/hearth#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".turbo/test-context", "$TURBO_ROOT$/packages/cli/bin/**"]
    },
    // electron-vite writes three bundles (main, preload, renderer) to out/, not dist/, and
    // its config plus the split tsconfigs sit outside the generic task's "src/**" inputs.
    // Package-specific config REPLACES the generic entry, so ^build is repeated here.
    // No "codegen" dependency on purpose: the desktop app must not consume the premium
    // overlay glue that @bike4mind/client's codegen task generates.
    "@bike4mind/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"],
      "inputs": ["src/**", "electron.vite.config.ts", "tsconfig*.json", "package.json"]
    },
    // local-models bundles the Curated models list from catalog/model-hub, and its tests validate that file.
    // Desktop and the CLI get it only through this build, so ^build carries a manifest change to them.
    "@bike4mind/local-models#build": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsdown.config.ts", "package.json", "$TURBO_ROOT$/catalog/model-hub/**"]
    },
    "@bike4mind/local-models#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".turbo/test-context", "$TURBO_ROOT$/catalog/model-hub/**"]
    },
    // @bike4mind/workers compiles and tests apps/client/server code through its interim path
    // alias (apps/workers/tsconfig.json), and some of that code imports the premium-generated
    // stubs @bike4mind/client's codegen writes - same cross-package edge as @bike4mind/scripts.
    // The extra inputs keep a client-only edit from replaying a cached workers result.
    // packages/scripts/help is imported from source (cron/helpDatalakeIngest.ts) and has no build
    // task, so ^build never hashes it - list it here for the same reason.
    "@bike4mind/workers#typecheck": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../client/**/*.ts",
        "../client/tsconfig.json",
        "../../packages/scripts/help/**/*.ts",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    "@bike4mind/workers#typecheck:native": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../client/**/*.ts",
        "../client/tsconfig.json",
        "../../packages/scripts/help/**/*.ts",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    "@bike4mind/workers#typecheck:fast": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../client/**/*.ts",
        "../client/tsconfig.json",
        "../../packages/scripts/help/**/*.ts",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    "@bike4mind/workers#test": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "../client/**/*.ts",
        "../client/tsconfig.json",
        "../../packages/scripts/help/**/*.ts",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    // Mirrors the entry above for the real-Mongo lane; turbo-test-cache.test.mjs keeps them equal.
    "@bike4mind/workers#test:integration": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "../client/**/*.ts",
        "../client/tsconfig.json",
        "../../packages/scripts/help/**/*.ts",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    // @bike4mind/server-utils is source-only (no build script), so ^build is not relied on to hash
    // its source: an edit there must not replay a cached client result. The package is listed as an
    // input explicitly instead - the workers entries above carry the same glob. Package-specific
    // config REPLACES the generic entry, so dependsOn is repeated here.
    "@bike4mind/client#typecheck": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    "@bike4mind/client#typecheck:native": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    "@bike4mind/client#typecheck:fast": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**"
      ]
    },
    // Keyed on its own files plus the outside files its unit and integration suites read. Tests
    // that scan the whole repo are `*.repo.test.ts`, run uncached by `test:repo` (see
    // apps/client/vitest.config.mts), which is what keeps this package off WHOLE_REPO_TEST_PACKAGES.
    "@bike4mind/client#test": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**",
        "$TURBO_ROOT$/sst.config.ts",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/packages/premium/*/package.json",
        "$TURBO_ROOT$/packages/premium/*/src/**",
        "$TURBO_ROOT$/packages/scripts/migrate/migrations/**",
        "$TURBO_ROOT$/scripts/check-no-overlay-literals.sh",
        "$TURBO_ROOT$/scripts/qa-backfill-slack.mjs",
        "$TURBO_ROOT$/scripts/__tests__/fixtures/**",
        "$TURBO_ROOT$/packages/scripts/help/**",
        "$TURBO_ROOT$/packages/scripts/index.ts",
        "$TURBO_ROOT$/packages/scripts/migrate/migrationManager.ts",
        "$TURBO_ROOT$/docs-site/docs/**",
        "$TURBO_ROOT$/catalog/model-hub/**"
      ]
    },
    // Mirrors the entry above for the real-Mongo lane; turbo-test-cache.test.mjs keeps them equal.
    "@bike4mind/client#test:integration": {
      "dependsOn": ["codegen", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "../../packages/server-utils/**",
        "!../../packages/server-utils/node_modules/**",
        "!../../packages/server-utils/.turbo/**",
        "$TURBO_ROOT$/sst.config.ts",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/packages/premium/*/package.json",
        "$TURBO_ROOT$/packages/premium/*/src/**",
        "$TURBO_ROOT$/packages/scripts/migrate/migrations/**",
        "$TURBO_ROOT$/scripts/check-no-overlay-literals.sh",
        "$TURBO_ROOT$/scripts/qa-backfill-slack.mjs",
        "$TURBO_ROOT$/scripts/__tests__/fixtures/**",
        "$TURBO_ROOT$/packages/scripts/help/**",
        "$TURBO_ROOT$/packages/scripts/index.ts",
        "$TURBO_ROOT$/packages/scripts/migrate/migrationManager.ts",
        "$TURBO_ROOT$/docs-site/docs/**",
        "$TURBO_ROOT$/catalog/model-hub/**"
      ]
    },
    // server-utils reads src/premium-generated/ (written by @bike4mind/client's codegen and
    // gitignored, so outside $TURBO_DEFAULT$): same cross-package edge as @bike4mind/scripts.
    "@bike4mind/server-utils#typecheck": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": ["$TURBO_DEFAULT$", "src/premium-generated/**"]
    },
    "@bike4mind/server-utils#typecheck:native": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": ["$TURBO_DEFAULT$", "src/premium-generated/**"]
    },
    "@bike4mind/server-utils#typecheck:fast": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": ["$TURBO_DEFAULT$", "src/premium-generated/**"]
    },
    // The wiring tests read app, infra and self-host files outside this package.
    "@bike4mind/server-utils#test": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "src/premium-generated/**",
        "../../apps/client/pages/**",
        "../../apps/client/server/**",
        "../../apps/workers/src/**",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/compose.*.yaml",
        "$TURBO_ROOT$/selfhost/kubernetes/files/**",
        "$TURBO_ROOT$/scripts/smoke_selfhost_objectstore.py"
      ]
    },
    // Mirrors the entry above for the real-Mongo lane; turbo-test-cache.test.mjs keeps them equal.
    "@bike4mind/server-utils#test:integration": {
      "dependsOn": ["^build", "@bike4mind/client#codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "src/premium-generated/**",
        "../../apps/client/pages/**",
        "../../apps/client/server/**",
        "../../apps/workers/src/**",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/compose.*.yaml",
        "$TURBO_ROOT$/selfhost/kubernetes/files/**",
        "$TURBO_ROOT$/scripts/smoke_selfhost_objectstore.py"
      ]
    },
    // The moderation scanner reads source outside this package.
    "@bike4mind/infra#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".turbo/test-context",
        "$TURBO_ROOT$/turbo.json",
        "../../apps/client/pages/**",
        "../../apps/client/server/**",
        "../../apps/workers/src/**",
        "../../packages/server-utils/src/**",
        "../services/src/**",
        "../slack/src/**",
        "../../packages/server-utils/src/**"
      ]
    },
    // CI runs test tasks with --only (no dependency builds), which also drops the dependencies from
    // the hash. .turbo/test-context, written by scripts/turbo-test-cache.mjs, carries their
    // full-graph hashes back in, so every test task - generic or package-specific - must list it.
    // scripts/__tests__/turbo-test-cache.test.mjs fails the build when one does not.
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".turbo/test-context"]
    },
    // The real-Mongo lanes (`*.e2e.test.ts`). Each override mirrors the package's `test` entry.
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".turbo/test-context"]
    },
    "openapi:generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
